.env
strategy-lab/intraday/signalbot/.env
.signalbot/
__pycache__/
*.pyc
.pytest_tmp/

# graphify AST onbellegi ve uretilen raporlar (~11 MB). Kaynaktan yeniden
# uretilebilir: `graphify . --code-only`.
graphify-out/

# Lab ciktilari: ~167 MB, hepsi backtest kosumundan yeniden uretilebilir.
#
# ISTISNA -- forward defteri YENIDEN URETILEMEZ. Canli paper islemlerin
# birikmis kaydi; tum modul kararlari (tier, risk, terfi) buna dayaniyor.
# Silinirse aylarin kaniti gider, backtest'ten geri gelmez.
#
# NOT: `outputs/` diye tek satir yazmak yetmez -- git dislanan bir dizinin
# ICINE HIC BAKMAZ, o yuzden alttaki `!` kurali calismaz. Her ara dizin
# tek tek acilip yeniden kapatilmali (asagidaki */! merdiveni).
strategy-lab/outputs/*
!strategy-lab/outputs/intraday/
strategy-lab/outputs/intraday/*
!strategy-lab/outputs/intraday/forward_ea/
strategy-lab/outputs/intraday/forward_ea/*
!strategy-lab/outputs/intraday/forward_ea/forward_ledger.csv
# Icra defteri de yeniden uretilemez: gercek islemlerde kurala uyumun tek
# kaydi. Challenge patlarsa "kural mi yanlisti, ben mi uymadim" sorusunu
# yalnizca bu dosya cevaplar.
!strategy-lab/outputs/intraday/forward_ea/icra_defteri.csv
# Bulut defteri de yeniden uretilemez (bedava feed'in gecmisi 60 gunle
# sinirli). State dosyasi olmadan defter kaldigi yeri bilemez -- ikisi
# birlikte commit'lenir.
!strategy-lab/outputs/intraday/forward_ea/cloud_ledger.csv
!strategy-lab/outputs/intraday/forward_ea/cloud_state.json
# Diskresyoner defter de yeniden uretilemez: elle acilan islemlerin ve
# giris ONCESI yazilmis tezlerin tek kaydi. Backtest'i yok, bu dosya yoksa
# "yorum yetenegi ise yariyor mu" sorusunun cevabi da yok.
!strategy-lab/outputs/intraday/forward_ea/diskresyoner_defter.csv
